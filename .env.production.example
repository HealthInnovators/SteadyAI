NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://user:password@db-host:5432/steadyai
DIRECT_URL=postgresql://user:password@db-host:5432/steadyai

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=nutrition-images

# Public domains
APP_DOMAIN=www.goodhealth247.com
API_DOMAIN=api.goodhealth247.com
PUBLIC_BASE_URL=https://api.goodhealth247.com
NEXT_PUBLIC_API_BASE_URL=https://api.goodhealth247.com
BACKEND_IMAGE=ghcr.io/openhealthagents/steadyai-backend:main
WEB_IMAGE=ghcr.io/openhealthagents/steadyai-web:main

# Web auth
# Supabase redirect URLs must include:
# - https://www.example.com/auth/callback
# - https://api.example.com/oauth/callback
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_ENABLE_APPLE_AUTH=false
EXERCISE_MEDIA_PUBLIC_BASE_URL=https://your-project-ref.supabase.co/storage/v1/object/public/exercise-media
EXERCISE_MEDIA_STORAGE_BUCKET=exercise-media
EXERCISE_MEDIA_LOCAL_DIR=exercise-media

# TLS / Caddy
ACME_EMAIL=contact@goodhealth247.com
GHCR_USERNAME=
GHCR_TOKEN=

# MCP auth
APPS_MCP_API_KEY=
OPENAI_APPS_CHALLENGE_TOKEN=

# AI providers
NUTRITION_AI_PROVIDER=gemini
LLM_PROVIDER=openai
LLM_TIMEOUT_MS=15000

OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4.1-mini

GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=your-groq-key
GROQ_MODEL=llama-3.3-70b-versatile
